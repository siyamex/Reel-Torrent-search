# Templated by the official nginx image's built-in entrypoint (envsubst on
# files under /etc/nginx/templates/) so BACKEND_HOST can be overridden at
# `docker run` time — needed when backend/frontend/redis are deployed as
# separate containers (e.g. CasaOS manual installs) rather than via Compose,
# where there's no "backend" service-name DNS to resolve.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    location /api/ {
        proxy_pass http://${BACKEND_HOST};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cookie_path / /;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|svg|png|jpg|jpeg|gif|woff2?)$ {
        expires 7d;
        add_header Cache-Control "public, max-age=604800, immutable";
    }
}
