# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public URL of the frontend, used for CORS
FRONTEND_URL=http://localhost:5173

# ---------------------------------------------------------------------------
# Sessions / cookies / accounts
# Each app user logs in separately and connects their own Seedr account.
# ---------------------------------------------------------------------------
SESSION_SECRET=replace-with-a-long-random-string
# Where user accounts are persisted when REDIS_URL isn't set. Ignored (Redis
# is used instead) when REDIS_URL is configured below.
DATA_DIR=./data

# ---------------------------------------------------------------------------
# TMDB (https://www.themoviedb.org/settings/api)
# ---------------------------------------------------------------------------
TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# ---------------------------------------------------------------------------
# Prowlarr (self-hosted) — Torznab search is proxied through Prowlarr's own
# aggregate search API, which fans a query out to all enabled indexers.
# ---------------------------------------------------------------------------
PROWLARR_URL=http://localhost:9696
PROWLARR_API_KEY=

# ---------------------------------------------------------------------------
# Seedr
# No configuration needed here. Seedr has no self-serve OAuth app
# registration, so each user connects with their own Seedr email/password
# directly from their Profile page in the app (see seedrService.ts) — the
# backend only ever stores the resulting access/refresh tokens, never the
# password itself.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Caching
# ---------------------------------------------------------------------------
# If set, Redis is used for caching. If unset/unreachable, an in-memory
# cache is used automatically as a fallback.
REDIS_URL=
CACHE_TTL_SECONDS=21600
