# Copy this file to "backend.env" next to docker-compose.casaos.yml and fill
# in real values. backend.env is just a plain env file for Docker Compose —
# it is NOT built into the image, so keep it out of git (already gitignored).

NODE_ENV=production
PORT=4000

# The URL you'll actually use to reach the frontend — your Orange Pi's LAN
# IP (or hostname/domain if you have one), with the frontend's port. This is
# used for CORS, so it must match exactly what's in your browser's address
# bar or API requests will be rejected.
# e.g. http://192.168.1.50:8080
FRONTEND_URL=http://CHANGE-ME:8080

SESSION_SECRET=change-me-to-a-long-random-string
# Leave false unless this is served over HTTPS — true breaks login on a
# plain-HTTP LAN/Tailscale deployment (the browser silently drops Secure
# cookies over HTTP).
COOKIE_SECURE=false

TMDB_API_KEY=
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Point at your existing Prowlarr instance (not bundled in this compose file).
PROWLARR_URL=http://CHANGE-ME:9696
PROWLARR_API_KEY=

CACHE_TTL_SECONDS=21600
